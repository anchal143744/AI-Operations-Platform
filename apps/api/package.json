{
  "name": "@aop/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch --config nest-cli.dev.json --path tsconfig.dev.json",
    "build:dev": "tsc -p tsconfig.dev.json",
    "worker": "node dist/worker.js",
    "start": "node dist/main.js",
    "build": "nest build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aop/types": "workspace:*",
    "@aws-sdk/client-sesv2": "^3.1143.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.2.3",
    "@node-rs/argon2": "^2.2.0",
    "@node-rs/argon2-wasm32-wasi": "2.2.0",
    "@prisma/client": "^6.15.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@types/express": "^5.0.6"
  }
}
