  approvals      ApprovalRequest[]
  activityEvents ActivityEvent[]

  @@unique([id, organizationId, workspaceId], map: "ai_operations_id_tenant_key")
  @@index([organizationId, workspaceId, createdAt], map: "ai_operations_tenant_created_at_idx")
  @@index([organizationId, workspaceId, leadId], map: "ai_operations_tenant_lead_idx")
  @@index([organizationId, workspaceId, conversationId], map: "ai_operations_tenant_conversation_idx")
  @@index([organizationId, workspaceId, followUpId], map: "ai_operations_tenant_follow_up_idx")
  @@index([organizationId, workspaceId, workflowId], map: "ai_operations_tenant_workflow_idx")
  @@map("ai_operations")
}

model ApprovalRequest {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  workspaceId    String          @map("workspace_id") @db.Uuid
  aiOperationId  String?         @map("ai_operation_id") @db.Uuid
  workflowId     String?         @map("workflow_id") @db.Uuid
  leadId         String?         @map("lead_id") @db.Uuid
  conversationId String?         @map("conversation_id") @db.Uuid
  followUpId     String?         @map("follow_up_id") @db.Uuid
  workflowExecutionId String?   @unique @map("workflow_execution_id") @db.Uuid
  status         ApprovalStatus @default(PENDING)
  reason         String?        @db.VarChar(500)
  expiresAt      DateTime?      @map("expires_at") @db.Timestamptz(3)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace      Workspace       @relation(fields: [workspaceId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  aiOperation    AIOperation?    @relation(fields: [aiOperationId, organizationId, workspaceId], references: [id, organizationId, workspaceId], onDelete: Restrict, onUpdate: Cascade)
  workflow       Workflow?       @relation(fields: [workflowId, organizationId, workspaceId], references: [id, organizationId, workspaceId], onDelete: Restrict, onUpdate: Cascade)
  lead           Lead?           @relation(fields: [leadId, organizationId, workspaceId], references: [id, organizationId, workspaceId], onDelete: Restrict, onUpdate: Cascade)
  conversation   Conversation?   @relation(fields: [conversationId, organizationId, workspaceId], references: [id, organizationId, workspaceId], onDelete: Restrict, onUpdate: Cascade)
  followUp       FollowUp?       @relation(fields: [followUpId, organizationId, workspaceId], references: [id, organizationId, workspaceId], onDelete: Restrict, onUpdate: Cascade)
  activityEvents ActivityEvent[]
  workflowExecution WorkflowExecution? @relation(fields: [workflowExecutionId, organizationId, workspaceId], references: [id, organizationId, workspaceId], onDelete: Restrict, onUpdate: Cascade)
  decision       ApprovalDecision?

  @@unique([id, organizationId, workspaceId], map: "approval_requests_id_tenant_key")
  @@unique([workflowExecutionId, organizationId, workspaceId], map: "approval_requests_execution_tenant_key")
  @@index([organizationId, workspaceId, createdAt], map: "approval_requests_tenant_created_at_idx")
  @@index([organizationId, workspaceId, aiOperationId], map: "approval_requests_tenant_ai_operation_idx")
  @@index([organizationId, workspaceId, workflowId], map: "approval_requests_tenant_workflow_idx")
  @@index([status, expiresAt], map: "approval_requests_expiry_idx")
  @@map("approval_requests")
}

model ActivityEvent {
  id                String           @id @default(uuid()) @db.Uuid
  organizationId    String           @map("organization_id") @db.Uuid
  workspaceId       String           @map("workspace_id") @db.Uuid
  actorMembershipId String?          @map("actor_membership_id") @db.Uuid
  leadId            String?          @map("lead_id") @db.Uuid
  conversationId    String?          @map("conversation_id") @db.Uuid
  followUpId        String?          @map("follow_up_id") @db.Uuid
  aiOperationId     String?          @map("ai_operation_id") @db.Uuid
  workflowId        String?          @map("workflow_id") @db.Uuid
  approvalRequestId String?          @map("approval_request_id") @db.Uuid
  actorType         ActivityActorType @map("actor_type")
  eventType         ActivityEventType @map("event_type")
  resourceType      String?           @map("resource_type") @db.VarChar(80)
  resourceId        String?           @map("resource_id") @db.Uuid
  action            String            @db.VarChar(120)
  summary           String            @db.VarChar(500)
  metadata          Json?
  occurredAt        DateTime         @default(now()) @map("occurred_at") @db.Timestamptz(3)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  workspace         Workspace        @relation(fields: [workspaceId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  actorMembership   Membership?      @relation(fields: [actorMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  lead              Lead?            @relation(fields: [leadId, organizationId, workspaceId], references: [id, organizationId, workspaceId], onDelete: Restrict, onUpdate: Cascade)
  conversation      Conversation?    @relation(fields: [conversationId, organizationId, workspaceId], references: [id, organizationId, workspaceId], onDelete: Restrict, onUpdate: Cascade)
  followUp          FollowUp?        @relation(fields: [followUpId, organizationId, workspaceId], references: [id, organizationId, workspaceId], onDelete: Restrict, onUpdate: Cascade)
  aiOperation       AIOperation?     @relation(fields: [aiOperationId, organizationId, workspaceId], references: [id, organizationId, workspaceId], onDelete: Restrict, onUpdate: Cascade)
  workflow          Workflow?        @relation(fields: [workflowId, organizationId, workspaceId], references: [id, organizationId, workspaceId], onDelete: Restrict, onUpdate: Cascade)
  approvalRequest   ApprovalRequest? @relation(fields: [approvalRequestId, organizationId, workspaceId], references: [id, organizationId, workspaceId], onDelete: Restrict, onUpdate: Cascade)

  @@index([organizationId, workspaceId, occurredAt], map: "activity_events_tenant_occurred_at_idx")
  @@index([organizationId, actorMembershipId, occurredAt], map: "activity_events_actor_occurred_at_idx")
  @@index([organizationId, workspaceId, eventType, occurredAt], map: "activity_events_tenant_type_occurred_at_idx")
  @@index([organizationId, workspaceId, resourceType, resourceId], map: "activity_events_tenant_resource_idx")
  @@map("activity_events")
}

// One deterministic, versioned policy per workflow in this first dry-run slice.
model Policy {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  workspaceId    String      @map("workspace_id") @db.Uuid
  workflowId     String      @unique @map("workflow_id") @db.Uuid
  mode           PolicyMode  @default(REQUIRE_APPROVAL)
  version        Int         @default(1)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace      Workspace   @relation(fields: [workspaceId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  workflow       Workflow    @relation(fields: [workflowId, organizationId, workspaceId], references: [id, organizationId, workspaceId], onDelete: Restrict, onUpdate: Cascade)
  evaluations    PolicyEvaluation[]

  @@unique([id, organizationId, workspaceId], map: "policies_id_tenant_key")
  @@unique([workflowId, organizationId, workspaceId], map: "policies_workflow_tenant_key")
  @@index([organizationId, workspaceId, updatedAt], map: "policies_tenant_updated_at_idx")
  @@map("policies")
}

model WorkflowExecution {
  id             String                  @id @default(uuid()) @db.Uuid
  organizationId String                  @map("organization_id") @db.Uuid
  workspaceId    String                  @map("workspace_id") @db.Uuid
  workflowId     String                  @map("workflow_id") @db.Uuid
  definitionVersionId String?            @map("definition_version_id") @db.Uuid
  initiatedByMembershipId String?        @map("initiated_by_membership_id") @db.Uuid
  idempotencyKey String                  @map("idempotency_key") @db.VarChar(120)
  status         WorkflowExecutionStatus @default(QUEUED)
  startedAt      DateTime?               @map("started_at") @db.Timestamptz(3)
  completedAt    DateTime?               @map("completed_at") @db.Timestamptz(3)
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace      Workspace               @relation(fields: [workspaceId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  workflow       Workflow                @relation(fields: [workflowId, organizationId, workspaceId], references: [id, organizationId, workspaceId], onDelete: Restrict, onUpdate: Cascade)
  definitionVersion WorkflowDefinitionVersion? @relation(fields: [definitionVersionId, organizationId, workspaceId], references: [id, organizationId, workspaceId], onDelete: Restrict, onUpdate: Cascade)
  initiatedByMembership Membership?      @relation(fields: [initiatedByMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  evaluation     PolicyEvaluation?
  approval       ApprovalRequest?
  steps          ExecutionStep[]
  outboxEvents   OutboxEvent[]
  notification   Notification?

  @@unique([id, organizationId, workspaceId], map: "workflow_executions_id_tenant_key")
  @@unique([organizationId, workspaceId, idempotencyKey], map: "workflow_executions_tenant_idempotency_key")
  @@index([organizationId, workspaceId, status, createdAt], map: "workflow_executions_tenant_status_created_at_idx")
  @@index([organizationId, workspaceId, workflowId, createdAt], map: "workflow_executions_tenant_workflow_created_at_idx")
  @@index([organizationId, initiatedByMembershipId, createdAt], map: "workflow_executions_initiator_created_at_idx")
  @@index([organizationId, workspaceId, definitionVersionId], map: "workflow_executions_definition_version_idx")
  @@map("workflow_executions")
}

// An internal, persisted delivery to one verified organization membership.
// It is not an email, push, or external communication claim.
model Notification {
  id                    String            @id @default(uuid()) @db.Uuid
  organizationId        String            @map("organization_id") @db.Uuid
  workspaceId           String            @map("workspace_id") @db.Uuid
  recipientMembershipId String            @map("recipient_membership_id") @db.Uuid
  workflowExecutionId   String            @unique @map("workflow_execution_id") @db.Uuid
  title                 String            @db.VarChar(160)
  body                  String            @db.VarChar(1000)
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  readAt                DateTime?         @map("read_at") @db.Timestamptz(3)
  workspace             Workspace         @relation(fields: [workspaceId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  recipientMembership   Membership        @relation(fields: [recipientMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  workflowExecution     WorkflowExecution @relation(fields: [workflowExecutionId, organizationId, workspaceId], references: [id, organizationId, workspaceId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([id, organizationId, workspaceId], map: "notifications_id_tenant_key")
  @@unique([workflowExecutionId, organizationId, workspaceId], map: "notifications_execution_tenant_key")
  @@index([organizationId, workspaceId, recipientMembershipId, createdAt], map: "notifications_recipient_created_at_idx")
  @@index([organizationId, workspaceId, recipientMembershipId, readAt], map: "notifications_recipient_read_at_idx")
  @@map("notifications")
}

model PolicyEvaluation {
  id             String                 @id @default(uuid()) @db.Uuid
  organizationId String                 @map("organization_id") @db.Uuid
  workspaceId    String                 @map("workspace_id") @db.Uuid
  policyId       String                 @map("policy_id") @db.Uuid
  executionId    String                 @unique @map("execution_id") @db.Uuid
  policyVersion  Int                    @map("policy_version")
  result         PolicyEvaluationResult
  evaluatedAt    DateTime               @default(now()) @map("evaluated_at") @db.Timestamptz(3)
  workspace      Workspace              @relation(fields: [workspaceId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  policy         Policy                  @relation(fields: [policyId, organizationId, workspaceId], references: [id, organizationId, workspaceId], onDelete: Restrict, onUpdate: Cascade)
  execution      WorkflowExecution      @relation(fields: [executionId, organizationId, workspaceId], references: [id, organizationId, workspaceId], onDelete: Restrict, onUpdate: Cascade)

  @@index([organizationId, workspaceId, evaluatedAt], map: "policy_evaluations_tenant_evaluated_at_idx")
  @@unique([executionId, organizationId, workspaceId], map: "policy_evaluations_execution_tenant_key")
  @@map("policy_evaluations")
}

model ApprovalDecision {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  workspaceId    String          @map("workspace_id") @db.Uuid
  requestId      String          @unique @map("request_id") @db.Uuid
  actorMembershipId String       @map("actor_membership_id") @db.Uuid
  decision       ApprovalStatus
  note           String?         @db.VarChar(1000)
  decidedAt      DateTime        @default(now()) @map("decided_at") @db.Timestamptz(3)
  workspace      Workspace       @relation(fields: [workspaceId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  request        ApprovalRequest @relation(fields: [requestId, organizationId, workspaceId], references: [id, organizationId, workspaceId], onDelete: Restrict, onUpdate: Cascade)
  actorMembership Membership     @relation(fields: [actorMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)

  @@index([organizationId, workspaceId, decidedAt], map: "approval_decisions_tenant_decided_at_idx")
  @@unique([requestId, organizationId, workspaceId], map: "approval_decisions_request_tenant_key")
  @@map("approval_decisions")
}

model ExecutionStep {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  workspaceId    String              @map("workspace_id") @db.Uuid
  executionId    String              @map("execution_id") @db.Uuid
  stepNumber     Int                 @map("step_number")
  actionType     WorkflowActionType  @map("action_type")
  status         ExecutionStepStatus @default(PENDING)
  startedAt      DateTime?           @map("started_at") @db.Timestamptz(3)
  completedAt    DateTime?           @map("completed_at") @db.Timestamptz(3)
  workspace      Workspace           @relation(fields: [workspaceId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  execution      WorkflowExecution   @relation(fields: [executionId, organizationId, workspaceId], references: [id, organizationId, workspaceId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([executionId, stepNumber], map: "execution_steps_execution_number_key")
  @@index([organizationId, workspaceId, executionId], map: "execution_steps_tenant_execution_idx")
